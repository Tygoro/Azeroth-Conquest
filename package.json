{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter \"@workspace/conquest-calculator\" dev",
    "dev:frontend": "pnpm --filter \"@workspace/conquest-calculator\" dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:frontend": "pnpm --filter \"@workspace/conquest-calculator\" build",
    "talents:parse-coa": "pnpm --filter \"@workspace/scripts\" talents:parse-coa",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
